new file mode 100644
index 0000000..1521429
--- /dev/null
+++ b/src/renderer/manifold_predict.zig
@@ -0,0 +1,70 @@
+//! Manifold: keystrokes' echo predicted (`State.ManifoldPrediction`), laid
+//! over a frame's copy of the screen — never the terminal itself, which
+//! only the host's output changes — and the cursor moved to where it would
+//! be. Only while the screen is scrolled to the bottom, where they are.
+
+const std = @import("std");
+const terminal = @import("../terminal/main.zig");
+const State = @import("State.zig");
+
+pub fn apply(rs: *terminal.RenderState, p: *const State.ManifoldPrediction, t: *const terminal.Terminal) void {
+    if (!t.screens.active.viewportIsBottom()) return;
+    const rows = rs.row_data.slice();
+    const row_cells = rows.items(.cells);
+    const row_dirty = rows.items(.dirty);
+    const pen = rs.cursor.style;
+
+    // The rows' cells as they are, for those moved along (copied before
+    // any is written over).
+    const max_cols = 1024;
+    var saved_y: ?usize = null;
+    var saved_raw: [max_cols]terminal.page.Cell = undefined;
+    var saved_style: [max_cols]terminal.Style = undefined;
+
+    for (p.cells[0..p.len]) |c| {
+        if (c.y >= rs.rows or c.x >= rs.cols) continue;
+        const cells = row_cells[c.y].slice();
+        const raws = cells.items(.raw);
+        const styles = cells.items(.style);
+        if (c.source >= 0) {
+            const src: usize = @intCast(c.source);
+            if (src >= rs.cols or rs.cols > max_cols) continue;
+            if (saved_y != c.y) {
+                saved_y = c.y;
+                @memcpy(saved_raw[0..rs.cols], raws[0..rs.cols]);
+                @memcpy(saved_style[0..rs.cols], styles[0..rs.cols]);
+            }
+            // A plain cell (a wide one, or one of several codepoints, isn't
+            // predicted: its parts would come apart).
+            var raw = saved_raw[src];
+            if (raw.wide != .narrow or raw.content_tag == .codepoint_grapheme) continue;
+            raw.hyperlink = false;
+            raws[c.x] = raw;
+            styles[c.x] = saved_style[src];
+        } else {
+            // Saved first, if this row's cells are to be moved along too.
+            if (saved_y != c.y and rs.cols <= max_cols) {
+                saved_y = c.y;
+                @memcpy(saved_raw[0..rs.cols], raws[0..rs.cols]);
+                @memcpy(saved_style[0..rs.cols], styles[0..rs.cols]);
+            }
+            var raw: terminal.page.Cell = .{};
+            raw.content_tag = .codepoint;
+            raw.content = .{ .codepoint = @intCast(c.codepoint) };
+            // In the cursor's style (a blank: plain). The id only says it has
+            // one; the renderer takes the style from the copy.
+            const styled = c.codepoint != 0 and !pen.default();
+            if (styled) raw.style_id = 1;
+            raws[c.x] = raw;
+            styles[c.x] = if (styled) pen else .{};
+        }
+        row_dirty[c.y] = true;
+    }
+    if (p.cursor) |cur| if (cur.y < rs.rows and cur.x < rs.cols) {
+        rs.cursor.viewport = .{ .x = cur.x, .y = cur.y, .wide_tail = false };
+        rs.cursor.active = .{ .x = cur.x, .y = cur.y };
+        rs.cursor.cell = row_cells[cur.y].slice().items(.raw)[cur.x];
+        row_dirty[cur.y] = true;
+    };
+    if (rs.dirty == .false) rs.dirty = .partial;
+}
