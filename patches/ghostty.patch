diff --git a/src/manifold_vt.zig b/src/manifold_vt.zig
new file mode 100644
index 0000000..428148f
--- /dev/null
+++ b/src/manifold_vt.zig
@@ -0,0 +1,209 @@
+//! Manifold: a terminal kept on the host for each shell (in manifoldd), by
+//! the same emulator the app draws with. It's fed the shell's output as it
+//! comes and resized with the shell's pty, and is written out on asking as
+//! a snapshot: escape sequences that make the same screen, scrollback,
+//! modes and cursor again — what a terminal attaching is sent, or one that
+//! fell behind, in place of everything it missed.
+const std = @import("std");
+const vt = @import("ghostty-vt");
+
+const alloc = std.heap.smp_allocator;
+
+const Handle = struct {
+    terminal: vt.Terminal,
+    stream: vt.ReadonlyStream,
+};
+
+/// A terminal of this size, keeping `max_scrollback` bytes of history.
+export fn mvt_new(cols: u16, rows: u16, max_scrollback: usize) ?*Handle {
+    const h = alloc.create(Handle) catch return null;
+    h.terminal = vt.Terminal.init(alloc, .{
+        .cols = @max(cols, 1),
+        .rows = @max(rows, 1),
+        .max_scrollback = max_scrollback,
+    }) catch {
+        alloc.destroy(h);
+        return null;
+    };
+    h.stream = h.terminal.vtStream();
+    return h;
+}
+
+export fn mvt_free(h: *Handle) void {
+    h.stream.deinit();
+    h.terminal.deinit(alloc);
+    alloc.destroy(h);
+}
+
+/// The shell's output, as it came.
+export fn mvt_feed(h: *Handle, bytes: [*]const u8, len: usize) void {
+    h.stream.nextSlice(bytes[0..len]) catch {};
+}
+
+export fn mvt_resize(h: *Handle, cols: u16, rows: u16) void {
+    h.terminal.resize(alloc, @max(cols, 1), @max(rows, 1)) catch {};
+}
+
+/// Whether a full-screen program (the alternate screen) is showing.
+export fn mvt_alternate(h: *Handle) bool {
+    return h.terminal.screens.active_key == .alternate;
+}
+
+/// The terminal as escape sequences that make it again, from a fresh
+/// terminal of the same size: the primary screen's last `history` rows of
+/// history (all of it, if negative) and its screen, then (if a full-screen
+/// program shows) the alternate screen; the modes, scrolling region, tab
+/// stops, working directory, keyboard modes, cursor and its style. Not the
+/// palette: the app's own colors stay. The bytes are freed with
+/// `mvt_free_bytes`; null if it couldn't be made.
+export fn mvt_snapshot(h: *Handle, history: isize, out_len: *usize) ?[*]u8 {
+    var w: std.Io.Writer.Allocating = .init(alloc);
+    errdefer w.deinit();
+    write(h, history, &w.writer) catch {
+        w.deinit();
+        return null;
+    };
+    const bytes = w.toOwnedSlice() catch {
+        w.deinit();
+        return null;
+    };
+    out_len.* = bytes.len;
+    return bytes.ptr;
+}
+
+/// A screen's last `history` rows of history and the screen itself (all of
+/// its history, if negative).
+fn content(screen: *const vt.Screen, history: isize) vt.formatter.ScreenFormatter.Content {
+    if (history < 0) return .{ .selection = null };
+    const pages = &screen.pages;
+    const keep = @min(pages.total_rows, @as(usize, pages.rows) + @as(usize, @intCast(history)));
+    const start = pages.pin(.{ .screen = .{ .x = 0, .y = @intCast(pages.total_rows - keep) } }) orelse
+        return .{ .selection = null };
+    const end = pages.getBottomRight(.screen) orelse return .{ .selection = null };
+    return .{ .selection = vt.Selection.init(start, end, false) };
+}
+
+fn write(h: *Handle, history: isize, writer: *std.Io.Writer) !void {
+    const t = &h.terminal;
+    var extra: vt.formatter.TerminalFormatter.Extra = .all;
+    extra.palette = false;
+
+    // A line wrapped over rows is written as one, to wrap again where it's
+    // drawn (and be one line there, to copy or reflow): with autowrap on to
+    // begin with, whatever that terminal had; this one's own setting comes
+    // with its modes, and if it's off, its rows are written as they are.
+    try writer.writeAll("\x1b[?7h");
+
+    // A full-screen program showing: the primary screen's history and
+    // screen first (as a shell left them), then the terminal's own state,
+    // which switches to the alternate screen, and what's on it.
+    if (t.screens.active_key == .alternate) {
+        if (t.screens.get(.primary)) |primary| {
+            var pf: vt.formatter.ScreenFormatter = .init(primary, .vt);
+            pf.content = content(primary, history);
+            pf.extra = .styles;
+            pf.opts.unwrap = true;
+            try pf.format(writer);
+            try writer.writeAll("\x1b[0m");
+        }
+    }
+
+    var f: vt.formatter.TerminalFormatter = .init(t, .vt);
+    f.content = content(t.screens.active, history);
+    f.extra = extra;
+    f.opts.unwrap = t.modes.get(.wraparound);
+    try f.format(writer);
+
+    // The cursor where it is: the scrolling region and tab stops, written
+    // after it, moved it (to the top, to the last tab stop).
+    const c = &t.screens.active.cursor;
+    var y: usize = c.y;
+    var x: usize = c.x;
+    if (t.modes.get(.origin)) {
+        y -|= t.scrolling_region.top;
+        x -|= t.scrolling_region.left;
+    }
+    try writer.print("\x1b[{d};{d}H", .{ y + 1, x + 1 });
+}
+
+export fn mvt_free_bytes(bytes: [*]u8, len: usize) void {
+    alloc.free(bytes[0..len]);
+}
+
+/// The primary screen (where a shell's history is, whatever shows).
+fn primaryScreen(h: *Handle) ?*vt.Screen {
+    return h.terminal.screens.get(.primary);
+}
+
+/// How many rows have ever gone into the primary screen's history: a row's
+/// number there stays its own as more scroll off after it.
+export fn mvt_history_end(h: *Handle) u64 {
+    const s = primaryScreen(h) orelse return 0;
+    return s.pages.manifoldHistoryEnd();
+}
+
+/// The number of the earliest row of history still kept.
+export fn mvt_history_start(h: *Handle) u64 {
+    const s = primaryScreen(h) orelse return 0;
+    return s.pages.manifold_dropped;
+}
+
+/// The primary screen's history rows `from` to `to` (numbered as
+/// `mvt_history_end` counts; those no longer kept left out) as escape
+/// sequences: their text and styles, a soft-wrapped line written as one,
+/// no newline after the last. Freed with `mvt_free_bytes`; null if
+/// there's nothing in that range or it couldn't be made.
+/// The first row (as `mvt_history_end` counts them) of the line history row
+/// `row` is part of, looking no further up than `floor` (and what's kept):
+/// where history can be cut without cutting a line wrapped over rows.
+export fn mvt_history_line_start(h: *Handle, row: u64, floor: u64) u64 {
+    const s = primaryScreen(h) orelse return row;
+    const pages = &s.pages;
+    const low = @max(floor, pages.manifold_dropped);
+    var r = row;
+    while (r > low) : (r -= 1) {
+        const p = pages.pin(.{ .screen = .{ .y = @intCast(r - 1 - pages.manifold_dropped) } }) orelse break;
+        if (!p.rowAndCell().row.wrap) break;
+    }
+    return r;
+}
+
+export fn mvt_history_range(h: *Handle, from: u64, to: u64, out_len: *usize) ?[*]u8 {
+    const s = primaryScreen(h) orelse return null;
+    const pages = &s.pages;
+    const start = @max(from, pages.manifold_dropped);
+    const end = @min(to, pages.manifoldHistoryEnd());
+    if (start >= end) return null;
+    const top = pages.pin(.{ .screen = .{ .x = 0, .y = @intCast(start - pages.manifold_dropped) } }) orelse return null;
+    const bottom = pages.pin(.{ .screen = .{ .x = pages.cols - 1, .y = @intCast(end - 1 - pages.manifold_dropped) } }) orelse return null;
+    var w: std.Io.Writer.Allocating = .init(alloc);
+    var f: vt.formatter.ScreenFormatter = .init(s, .vt);
+    f.content = .{ .selection = vt.Selection.init(top, bottom, false) };
+    f.extra = .styles;
+    // A line wrapped over rows is written as one, so it wraps again where
+    // it goes (and is one line there, to copy or reflow).
+    f.opts.unwrap = true;
+    f.format(&w.writer) catch {
+        w.deinit();
+        return null;
+    };
+    w.writer.writeAll("\x1b[0m") catch {};
+    // Ended with a newline, unless the last row goes on in the row after it
+    // (the line is cut there): so the rows' end is told, and blank rows at
+    // the end (which the formatter leaves off) are kept.
+    if (!bottom.rowAndCell().row.wrap) {
+        var blank: u64 = 0;
+        while (blank < end - start) : (blank += 1) {
+            const p = pages.pin(.{ .screen = .{ .y = @intCast(end - 1 - blank - pages.manifold_dropped) } }) orelse break;
+            if (vt.Cell.hasTextAny(p.cells(.all))) break;
+        }
+        const newlines = if (blank == end - start) blank else blank + 1;
+        for (0..newlines) |_| w.writer.writeAll("\r\n") catch {};
+    }
+    const bytes = w.toOwnedSlice() catch {
+        w.deinit();
+        return null;
+    };
+    out_len.* = bytes.len;
+    return bytes.ptr;
+}
