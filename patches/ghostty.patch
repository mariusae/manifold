diff --git a/src/renderer/manifold_contrast.zig b/src/renderer/manifold_contrast.zig
new file mode 100644
index 0000000..8a853dc
--- /dev/null
+++ b/src/renderer/manifold_contrast.zig
@@ -0,0 +1,344 @@
+//! Manifold: automatic contrast correction, after apex's contrast.rs.
+//!
+//! Programs choose their colours for a dark terminal and name them outright
+//! (a 256-colour index, a truecolor triple), so on light paper an `ls` or an
+//! `fd` comes out in pale greens nobody can read. Every cell's ink is checked
+//! against the paper it sits on as the cells are built, and where the two do
+//! not read, the ink -- and only the ink -- is moved in lightness, away from
+//! the paper, until they do. Its hue and chroma stay (a yellow stays a yellow,
+//! deeper), the hue turned partway toward the nearest of the theme's own
+//! sixteen so the corrected colours belong with the theme's. "Reads" is WCAG
+//! AA (4.5:1), in the eye of a typical viewer and, in `deuteranopia` mode, of a
+//! deuteranope too, since a red reads lighter to the latter and one that
+//! passes for the first may not for the second. An ink is not set on the edge
+//! of reading but mirrored about it: one that lay a little beyond the edge
+//! lands a little inside, one far beyond lands deep, so the shades a program
+//! tells its things apart by stay apart -- and to a deuteranope, who has
+//! lightness where others have hue, stay two colours. The moves are in Oklab,
+//! where a step in lightness looks the same size on any hue, and answers are
+//! cached, so a cell costs a lookup.
+//!
+//! Colours here are 0xRRGGBB, so this file stands alone (`zig test` it).
+
+const std = @import("std");
+
+pub const Mode = enum(u2) {
+    none = 0,
+    typical = 1,
+    deuteranopia = 2,
+};
+
+/// WCAG AA for text: 4.5 to 1.
+pub const target: f32 = 4.5;
+
+/// The nearest theme hue is turned toward this much of the way, and only
+/// when it is this close (radians).
+const harmony_reach: f32 = 0.7;
+const harmony_pull: f32 = 0.5;
+
+/// Under this Oklab chroma a colour is a grey, with no hue to keep.
+const grey: f32 = 0.04;
+
+/// How far inside the edge of reading an ink lands, of how far beyond it
+/// it lay.
+const mirror: f32 = 0.5;
+
+const Lin = [3]f32;
+
+fn toLinear(c: u32) f32 {
+    const x: f32 = @as(f32, @floatFromInt(c & 0xff)) / 255.0;
+    return if (x <= 0.04045) x / 12.92 else std.math.pow(f32, (x + 0.055) / 1.055, 2.4);
+}
+
+fn fromLinear(c: f32) u32 {
+    const x = std.math.clamp(c, 0.0, 1.0);
+    const s = if (x <= 0.0031308) x * 12.92 else 1.055 * std.math.pow(f32, x, 1.0 / 2.4) - 0.055;
+    return @intFromFloat(@round(s * 255.0));
+}
+
+fn linear(rgb: u32) Lin {
+    return .{ toLinear(rgb >> 16), toLinear(rgb >> 8), toLinear(rgb) };
+}
+
+fn pack(l: Lin) u32 {
+    return (fromLinear(l[0]) << 16) | (fromLinear(l[1]) << 8) | fromLinear(l[2]);
+}
+
+/// WCAG relative luminance.
+fn luminance(l: Lin) f32 {
+    return 0.2126 * std.math.clamp(l[0], 0.0, 1.0) +
+        0.7152 * std.math.clamp(l[1], 0.0, 1.0) +
+        0.0722 * std.math.clamp(l[2], 0.0, 1.0);
+}
+
+/// WCAG contrast ratio, 1 (none) to 21 (black on white).
+fn contrast(a: Lin, b: Lin) f32 {
+    const x = luminance(a);
+    const y = luminance(b);
+    return (@max(x, y) + 0.05) / (@min(x, y) + 0.05);
+}
+
+/// What a deuteranope sees of a colour (Machado, Oliveira and Fernandes
+/// 2009, deuteranopia at full severity, in linear RGB).
+const deuteranopia_matrix = [3][3]f32{
+    .{ 0.367322, 0.860646, -0.227968 },
+    .{ 0.280085, 0.672501, 0.047413 },
+    .{ -0.011820, 0.042940, 0.968881 },
+};
+
+fn deuteranope(l: Lin) Lin {
+    var out: Lin = undefined;
+    for (deuteranopia_matrix, 0..) |row, i| {
+        out[i] = row[0] * l[0] + row[1] * l[1] + row[2] * l[2];
+    }
+    return out;
+}
+
+/// The contrast as the worse of the viewers the mode serves sees it.
+fn contrastFor(mode: Mode, fg: Lin, bg: Lin) f32 {
+    const c = contrast(fg, bg);
+    if (mode != .deuteranopia) return c;
+    return @min(c, contrast(deuteranope(fg), deuteranope(bg)));
+}
+
+pub fn legible(mode: Mode, fg: u32, bg: u32) bool {
+    return contrastFor(mode, linear(fg), linear(bg)) >= target;
+}
+
+// Oklab, after Björn Ottosson (2020).
+
+fn oklab(c: Lin) [3]f32 {
+    const l = std.math.cbrt(0.4122214708 * c[0] + 0.5363325363 * c[1] + 0.0514459929 * c[2]);
+    const m = std.math.cbrt(0.2119034982 * c[0] + 0.6806995451 * c[1] + 0.1073969566 * c[2]);
+    const s = std.math.cbrt(0.0883024619 * c[0] + 0.2817188376 * c[1] + 0.6299787005 * c[2]);
+    return .{
+        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
+    };
+}
+
+fn fromOklab(lab: [3]f32) Lin {
+    const l0 = lab[0] + 0.3963377774 * lab[1] + 0.2158037573 * lab[2];
+    const m0 = lab[0] - 0.1055613458 * lab[1] - 0.0638541728 * lab[2];
+    const s0 = lab[0] - 0.0894841775 * lab[1] - 1.2914855480 * lab[2];
+    const l = l0 * l0 * l0;
+    const m = m0 * m0 * m0;
+    const s = s0 * s0 * s0;
+    return .{
+        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
+    };
+}
+
+const Lch = struct { l: f32, c: f32, h: f32 };
+
+/// Lightness, chroma and hue (radians) of a colour.
+fn oklch(c: Lin) Lch {
+    const lab = oklab(c);
+    return .{ .l = lab[0], .c = std.math.hypot(lab[1], lab[2]), .h = std.math.atan2(lab[2], lab[1]) };
+}
+
+fn inGamut(c: Lin) bool {
+    for (c) |x| if (x < -0.0005 or x > 1.0005) return false;
+    return true;
+}
+
+fn at(l: f32, c: f32, h: f32) Lin {
+    return fromOklab(.{ l, c * @cos(h), c * @sin(h) });
+}
+
+/// The colour of this lightness and hue, at this chroma if sRGB has it and
+/// else at the most it has.
+fn fit(l: f32, c: f32, h: f32) Lin {
+    const want = at(l, c, h);
+    if (inGamut(want)) return want;
+    var lo: f32 = 0;
+    var hi: f32 = c;
+    for (0..16) |_| {
+        const mid = (lo + hi) / 2;
+        if (inGamut(at(l, mid, h))) lo = mid else hi = mid;
+    }
+    var out = at(l, lo, h);
+    for (&out) |*x| x.* = std.math.clamp(x.*, 0.0, 1.0);
+    return out;
+}
+
+fn hueDistance(a: f32, b: f32) f32 {
+    const tau = std.math.tau;
+    const d = @mod(b - a, tau);
+    return if (d > std.math.pi) d - tau else d;
+}
+
+/// The hue turned partway toward the nearest of the theme's own, when one
+/// is near: the chromatic twelve of the sixteen, the greys having no hue to
+/// offer.
+fn harmonise(h: f32, c: f32, palette: *const [16]u32) f32 {
+    if (c < grey) return h;
+    var nearest: ?f32 = null;
+    for (palette, 0..) |rgb, i| {
+        if (i == 0 or i == 7 or i == 8 or i == 15) continue;
+        const t = oklch(linear(rgb));
+        if (t.c < grey) continue;
+        const d = hueDistance(h, t.h);
+        if (nearest == null or @abs(d) < @abs(nearest.?)) nearest = d;
+    }
+    if (nearest) |d| if (@abs(d) <= harmony_reach) return h + d * harmony_pull;
+    return h;
+}
+
+/// The ink `fg` as it should be drawn on the paper `bg`: itself where it
+/// reads, else moved in lightness until it does and half as far again.
+pub fn correct(mode: Mode, fg: u32, bg: u32, palette: *const [16]u32) u32 {
+    if (mode == .none or legible(mode, fg, bg)) return fg;
+    const b = linear(bg);
+    const lch = oklch(linear(fg));
+    const h = harmonise(lch.h, lch.c, palette);
+    // Toward whichever of black and white the paper reads better against:
+    // down on light paper, up on dark.
+    const end: f32 = if (contrastFor(mode, .{ 0, 0, 0 }, b) >= contrastFor(mode, .{ 1, 1, 1 }, b)) 0 else 1;
+    const Probe = struct {
+        mode: Mode,
+        b: Lin,
+        c: f32,
+        h: f32,
+        // Judged as drawn, in eight bits: the edge found in floats can
+        // fall a hair short once packed.
+        fn color(self: @This(), l: f32) u32 {
+            return pack(fit(l, self.c, self.h));
+        }
+        fn reads(self: @This(), l: f32) bool {
+            return contrastFor(self.mode, linear(self.color(l)), self.b) >= target;
+        }
+    };
+    const p: Probe = .{ .mode = mode, .b = b, .c = lch.c, .h = h };
+    if (p.reads(lch.l)) return p.color(lch.l);
+    // No ink of this hue reads on this paper: as far as it goes.
+    if (!p.reads(end)) return p.color(end);
+    // The edge of reading, then the mirror.
+    var lo = lch.l;
+    var hi = end;
+    for (0..20) |_| {
+        const mid = (lo + hi) / 2;
+        if (p.reads(mid)) hi = mid else lo = mid;
+    }
+    const edge = hi;
+    const mirrored = std.math.clamp(edge + (edge - lch.l) * mirror, 0.0, 1.0);
+    return if (p.reads(mirrored)) p.color(mirrored) else p.color(edge);
+}
+
+/// Remembers answers, so a cell costs a lookup. Answers depend on the
+/// palette (for harmonising), so a new palette clears it.
+pub const Cache = struct {
+    const size = 4096;
+    const empty = std.math.maxInt(u64);
+
+    keys: [size]u64 = [_]u64{empty} ** size,
+    values: [size]u32 = [_]u32{0} ** size,
+    palette: [16]u32 = [_]u32{0} ** 16,
+
+    /// Call before a batch of lookups with the palette they're against.
+    pub fn usePalette(self: *Cache, palette: *const [16]u32) void {
+        if (std.mem.eql(u32, &self.palette, palette)) return;
+        self.palette = palette.*;
+        @memset(&self.keys, empty);
+    }
+
+    pub fn lookup(self: *Cache, mode: Mode, fg: u32, bg: u32) u32 {
+        if (mode == .none) return fg;
+        const key = (@as(u64, fg) << 26) | (@as(u64, bg) << 2) | @intFromEnum(mode);
+        const slot: usize = @intCast(std.hash.int(key) % size);
+        if (self.keys[slot] == key) return self.values[slot];
+        const v = correct(mode, fg, bg, &self.palette);
+        self.keys[slot] = key;
+        self.values[slot] = v;
+        return v;
+    }
+};
+
+// Tests, after apex's.
+
+const test_palette = [16]u32{
+    0x24292f, 0xcf222e, 0x116329, 0x4d2d00, 0x0969da, 0x8250df, 0x1b7c83, 0x6e7781,
+    0x57606a, 0xa40e26, 0x1a7f37, 0x633c01, 0x218bff, 0xa475f9, 0x3192aa, 0x8c959f,
+};
+const paper: u32 = 0xfcfcfb;
+
+fn hueOf(rgb: u32) f32 {
+    return oklch(linear(rgb)).h;
+}
+fn lightnessOf(rgb: u32) f32 {
+    return oklch(linear(rgb)).l;
+}
+
+test "ink that reads is left exactly as it is" {
+    try std.testing.expectEqual(@as(u32, 0x24292f), correct(.deuteranopia, 0x24292f, paper, &test_palette));
+    try std.testing.expectEqual(@as(u32, 0xf0f0f0), correct(.deuteranopia, 0xf0f0f0, 0x1a1a1a, &test_palette));
+}
+
+test "a dark terminal's yellow deepens on light paper and stays a yellow" {
+    const y: u32 = 0xd6c000;
+    const got = correct(.deuteranopia, y, paper, &test_palette);
+    try std.testing.expect(got != y);
+    try std.testing.expect(legible(.deuteranopia, got, paper));
+    try std.testing.expect(lightnessOf(got) < lightnessOf(y));
+    try std.testing.expect(@abs(hueDistance(hueOf(y), hueOf(got))) < 0.4);
+}
+
+test "fd's pale green on white becomes a readable green" {
+    const g: u32 = 0x87ff87; // xterm 120, roughly what the screenshot showed
+    const got = correct(.deuteranopia, g, paper, &test_palette);
+    try std.testing.expect(legible(.deuteranopia, got, paper));
+    try std.testing.expect(@abs(hueDistance(hueOf(g), hueOf(got))) < 0.6);
+}
+
+test "a red that reads to most eyes but not a deuteranope's is corrected for them" {
+    const red: u32 = 0xe00000;
+    try std.testing.expect(legible(.typical, red, paper));
+    try std.testing.expect(!legible(.deuteranopia, red, paper));
+    try std.testing.expectEqual(red, correct(.typical, red, paper, &test_palette));
+    const got = correct(.deuteranopia, red, paper, &test_palette);
+    try std.testing.expect(legible(.deuteranopia, got, paper));
+    try std.testing.expect(@abs(hueDistance(hueOf(red), hueOf(got))) < 0.4);
+}
+
+test "a dark terminal's bright is a light one's deep" {
+    const y = correct(.deuteranopia, 0xb08a00, paper, &test_palette);
+    const by = correct(.deuteranopia, 0xd6c000, paper, &test_palette);
+    try std.testing.expect(lightnessOf(by) < lightnessOf(y) - 0.03);
+}
+
+test "greys are not given a hue" {
+    const got = correct(.deuteranopia, 0x888888, paper, &test_palette);
+    try std.testing.expect(legible(.deuteranopia, got, paper));
+    try std.testing.expect(oklch(linear(got)).c < 0.02);
+}
+
+test "every answer reads, or is as far as the hue goes" {
+    const papers = [_]u32{ paper, 0x1a1a1a, 0x000000, 0xffffff, 0x333333, 0xcccccc, 0x1c4fd6, 0xffd700 };
+    var r: u32 = 0;
+    while (r <= 255) : (r += 51) {
+        var g: u32 = 0;
+        while (g <= 255) : (g += 51) {
+            var b: u32 = 0;
+            while (b <= 255) : (b += 51) {
+                const fg = (r << 16) | (g << 8) | b;
+                for (papers) |bg| {
+                    const got = correct(.deuteranopia, fg, bg, &test_palette);
+                    try std.testing.expect(legible(.deuteranopia, got, bg) or got == 0 or got == 0xffffff);
+                }
+            }
+        }
+    }
+}
+
+test "the cache answers as the function does" {
+    var cache: Cache = .{};
+    cache.usePalette(&test_palette);
+    for ([_]u32{ 0x87ff87, 0xd6c000, 0x24292f, 0xe00000 }) |fg| {
+        const want = correct(.deuteranopia, fg, paper, &test_palette);
+        try std.testing.expectEqual(want, cache.lookup(.deuteranopia, fg, paper));
+        try std.testing.expectEqual(want, cache.lookup(.deuteranopia, fg, paper));
+    }
+}
