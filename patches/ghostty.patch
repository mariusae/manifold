diff --git a/src/termio/Manual.zig b/src/termio/Manual.zig
new file mode 100644
index 0000000..27637c9
--- /dev/null
+++ b/src/termio/Manual.zig
@@ -0,0 +1,125 @@
+//! Manifold: a backend whose bytes the embedding app carries itself — no
+//! pty and no process here. The app feeds the program's output in
+//! (`ghostty_surface_process_output`), and is handed what's typed and the
+//! terminal's size through callbacks; the program runs elsewhere (in
+//! Manifold, on a host's server, at the other end of a stream).
+const Manual = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+
+pub const Config = struct {
+    userdata: ?*anyopaque,
+    /// What's typed (and the terminal's answers to queries), to send on.
+    write: *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+    /// The size in cells, then in pixels.
+    resize: *const fn (?*anyopaque, u16, u16, u32, u32) callconv(.c) void,
+};
+
+config: Config,
+
+pub fn init(config: Config) Manual {
+    return .{ .config = config };
+}
+
+pub fn deinit(self: *Manual) void {
+    _ = self;
+}
+
+pub fn initTerminal(self: *Manual, t: *terminal.Terminal) void {
+    self.resize(.{
+        .columns = t.cols,
+        .rows = t.rows,
+    }, .{
+        .width = t.width_px,
+        .height = t.height_px,
+    }) catch unreachable;
+}
+
+pub fn threadEnter(
+    self: *Manual,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .manual = .{} };
+}
+
+pub fn threadExit(self: *Manual, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *Manual,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *Manual,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    self.config.resize(
+        self.config.userdata,
+        @intCast(grid_size.columns),
+        @intCast(grid_size.rows),
+        screen_size.width,
+        screen_size.height,
+    );
+}
+
+pub fn queueWrite(
+    self: *Manual,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = td;
+    if (!linefeed) {
+        self.config.write(self.config.userdata, data.ptr, data.len);
+        return;
+    }
+
+    // Linefeed mode: each \r sent as \r\n.
+    var buf: std.ArrayListUnmanaged(u8) = .empty;
+    defer buf.deinit(alloc);
+    for (data) |ch| {
+        try buf.append(alloc, ch);
+        if (ch == '\r') try buf.append(alloc, '\n');
+    }
+    self.config.write(self.config.userdata, buf.items.ptr, buf.items.len);
+}
+
+pub fn childExitedAbnormally(
+    self: *Manual,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
