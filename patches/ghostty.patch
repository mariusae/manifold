diff --git a/merge-archives.sh b/merge-archives.sh
new file mode 100755
index 0000000..15b166b
--- /dev/null
+++ b/merge-archives.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Manifold: Apple's libtool silently drops archive members that Zig 0.15 wrote
+# unaligned, so unpack every archive and repack the objects instead.
+set -e
+out="$1"; shift
+case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
+tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
+i=0
+for a in "$@"; do
+  case "$a" in /*) ;; *) a="$PWD/$a" ;; esac
+  i=$((i+1)); d="$tmp/$i"; mkdir "$d"
+  case "$a" in
+    *.o) cp "$a" "$d/" ;;
+    *)
+      dups=$(ar t "$a" | grep -v '^__.SYMDEF' | sort | uniq -d)
+      [ -z "$dups" ] || { echo "duplicate members in $a: $dups" >&2; exit 1; }
+      (cd "$d" && ar x "$a" && chmod u+rw ./*)
+      rm -f "$d"/__.SYMDEF* ;;
+  esac
+done
+find "$tmp" -name '*.o' > "$tmp/list"
+libtool -static -o "$out" -filelist "$tmp/list" 2>&1 | grep -v 'has no symbols' >&2 || true
